{
  "name": "comacard",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "contracts"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "@types/bun": "^1.3.14"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
