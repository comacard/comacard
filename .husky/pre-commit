# Biome checks only what is staged, so an unrelated mess elsewhere in the tree
# never blocks a commit. Fixes are written back and restaged.
bunx biome check --staged --write --no-errors-on-unmatched

staged_js=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.js' '*.jsx' '*.json' '*.jsonc')
[ -n "$staged_js" ] && echo "$staged_js" | xargs git add

# Solidity has its own formatter; forge is only required when contracts change.
staged_sol=$(git diff --cached --name-only --diff-filter=ACMR -- 'contracts/**/*.sol')
if [ -n "$staged_sol" ]; then
  if command -v forge >/dev/null 2>&1; then
    (cd contracts && forge fmt)
    echo "$staged_sol" | xargs git add
  else
    echo "warning: forge not found, skipping Solidity formatting" >&2
  fi
fi
