# ---------- dependencies ----------
node_modules/
.pnp.*
# contracts/ is pure Foundry: lib/ is restored by `forge install`,
# vendor/ is committed on purpose (see contracts/vendor/attestcoin/README.md)
contracts/lib/
contracts/node_modules/

# ---------- build output ----------
dist/
out/
build/
.next/
.turbo/
*.tsbuildinfo
contracts/out/
contracts/cache/
contracts/broadcast/
!contracts/broadcast/**/dry-run/

# ---------- coverage ----------
coverage/
lcov.info
*.lcov

# ---------- secrets & environment ----------
# never commit a real key: deploys here sign with DEPLOYER_PRIVATE_KEY
.env
.env.*
!.env.example
*.pem
*.key
*.keystore
secrets.json

# ---------- logs ----------
*.log
npm-debug.log*
yarn-debug.log*
bun-debug.log*
lerna-debug.log*

# ---------- editors & os ----------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ---------- misc ----------
.cache/
tmp/
*.tgz
