# ---------- dependencies ----------
node_modules/
.pnp.*
# contracts/ is pure Foundry: lib/ is restored by `forge install`,
# vendor/ is committed on purpose (see contracts/vendor/attestcoin/README.md)
contracts/lib/
contracts/node_modules/

# envio codegen output — regenerated by `envio codegen`, which every script that
# reads the types runs first
apps/indexer/.envio/
apps/indexer/envio-env.d.ts

# ---------- build output ----------
dist/
out/
build/
.next/
.turbo/
*.tsbuildinfo
contracts/out/
contracts/cache/
contracts/broadcast/
!contracts/broadcast/**/dry-run/

# ---------- coverage ----------
coverage/
lcov.info
*.lcov

# ---------- secrets & environment ----------
# never commit a real key: deploys here sign with DEPLOYER_PRIVATE_KEY
.env
.env.*
!.env.example
# symlink to this file, so Next finds it without flags. Named `.env` rather than `.env.local`
# because two names for one file is one name too many, and the symlink is the only env file the
# app has.
!apps/app/.env
*.pem
*.key
*.keystore
secrets.json

# ---------- logs ----------
*.log
npm-debug.log*
yarn-debug.log*
bun-debug.log*
lerna-debug.log*

# ---------- editors & os ----------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ---------- misc ----------
.cache/
tmp/
*.tgz

# kyc service state
kyc.sqlite*

# Vercel project links, one per deployed app.
#
# `.env*` is NOT repeated here, though `vercel link` adds it. The secrets block above already
# ignores `.env` and `.env.*` and then makes one exception for `apps/app/.env`, the symlink Next
# reads. An unanchored `.env*` after that exception matches at every level and cancels it, which
# would quietly drop the app's environment from a fresh clone.
.vercel
