# The seven the app actually reads. Every one is inlined into the browser bundle at build time,
# so none of them is a secret and all of them need a rebuild to change.
#
# The real values live in the repository-root `.env`, which `apps/app/.env` symlinks to. This file
# is the list, not the source.

# apps/api. Unset means the card screens show "backend not configured" rather than inventing one.
NEXT_PUBLIC_COMACARD_API_URL=

# Creditcoin CC3. The credit line and the Wormhole hub both live here.
NEXT_PUBLIC_CREDITCOIN_RPC_URL=
NEXT_PUBLIC_CREDIT_LINE=
NEXT_PUBLIC_REMOTE_COLLATERAL_HUB=

# Ethereum Sepolia. The Attestcoin vault.
NEXT_PUBLIC_SOURCE_VAULT=

# Envio. Changes on every indexer redeploy, and the dev tier keeps only three, so a stale one
# returns 404 rather than an error worth reading. `bunx envio-cloud indexer get` is the authority.
NEXT_PUBLIC_INDEXER_URL=

# Reown (WalletConnect) Cloud. Public by design. https://dashboard.reown.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Optional overrides. Each falls back to a public endpoint, so leave them blank unless a
# public RPC is rate limiting the demo.
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ETHEREUM_RPC_URL=
NEXT_PUBLIC_WORMHOLESCAN_URL=

# NEXT_PUBLIC_E2E is deliberately absent. Setting it to 1 swaps the whole wallet layer for a stub
# that signs without a prompt, which is correct under Playwright and catastrophic anywhere else.
