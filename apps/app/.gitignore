# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …except the template: it documents the NEXT_PUBLIC_* knobs and holds no secret by construction.
!.env.example
# …and except the symlink to the repository-root .env, which is how Next finds it without flags.
# This exception has to be repeated here rather than only at the root: git applies the deepest
# .gitignore last, so a root-level negation cannot un-ignore what `.env*` catches in this folder.
!.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
