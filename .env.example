# ---- Source chains (Attestcoin reads these) ----
# chainKey 1 on CC3 Testnet
SEPOLIA_RPC_URL="https://sepolia.infura.io/v3/<key>"
# chainKey 3 on CC3 Testnet — real mainnet history
MAINNET_RPC_URL="https://mainnet.infura.io/v3/<key>"

# ---- Creditcoin CC3 Testnet (proofs verified here) ----
CREDITCOIN_RPC_URL="https://rpc.cc3-testnet.creditcoin.network"
PROOF_BUILDER_URL="https://proof-gen-api.cc3-testnet.creditcoin.network"

# Precompiles (fixed, CC3)
BLOCK_PROVER_PRECOMPILE="0x0000000000000000000000000000000000000FD2"
CHAIN_INFO_PRECOMPILE="0x0000000000000000000000000000000000000fd3"
# EvmV1Decoder library, CC3 testnet
EVM_V1_DECODER_LIBRARY_ADDRESS="0x731c345d79Fb8BbDC541f9DF3b6317585F849F9f"

# ---- Deploy keys (never commit real values) ----
DEPLOYER_PRIVATE_KEY=""

# ---- Deployed addresses (filled after deploy) ----
SOURCE_VAULT_ADDRESS="0x911290c37E9558C704870f4C44CBdEA1B2B33303"
ASC_CREDIT_LINE_ADDRESS="0x18052272cC69113DE2b45d2BDB4E1fB287F4E906"
STAKING_ADAPTER_ADDRESS="0xA94218Dbdb142A10e32eF7b494105D27F47f7045"

# ---- KYC (Didit, https://business.didit.me) ----
DIDIT_API_KEY=""
DIDIT_WORKFLOW_ID=""
# Business Console → API & Webhooks → destination secret_shared_key.
# Subscribe the destination to: status.updated, data.updated
DIDIT_WEBHOOK_SECRET=""
# Where Didit sends the user after verification (optional)
KYC_CALLBACK_URL="http://localhost:3000/kyc/return"
KYC_DB_PATH="kyc.sqlite"
# Where apps/api reaches the KYC service
KYC_URL="http://localhost:3002"

# ---- API (apps/api) ----
# Browser origins allowed to call the API, comma-separated. "*" for dev.
CORS_ORIGIN="*"
# HMAC key that card numbers are derived from. Rotating it reissues every card.
CARD_SECRET=""

# ---- Indexer ----
# Envio Cloud gives every deployment its own URL on the Development plan, so
# this moves whenever main does. Read it from here, never hardcode it.
INDEXER_URL="https://indexer.dev.hyperindex.xyz/5d01570/v1/graphql"

# ---- Cardholder app (apps/app) ----
NEXT_PUBLIC_API_URL="https://api-production-1141.up.railway.app"
NEXT_PUBLIC_CREDIT_LINE="0x18052272cC69113DE2b45d2BDB4E1fB287F4E906"
NEXT_PUBLIC_CREDITCOIN_RPC_URL="https://rpc.cc3-testnet.creditcoin.network"
# Reown (WalletConnect) Cloud project id for the wallet modal. Public by design:
# it is inlined into the browser bundle. https://dashboard.reown.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID="b56e18d47c72ab683b10814fe9495694"

# ---- Card screen (apps/app) ----
# Origin of apps/api, the credit-line read surface. This is NOT the vault backend that
# NEXT_PUBLIC_API_URL points at; the two serve different routes. Unset means the card screen
# issues no request at all and says the backend is unconfigured.
NEXT_PUBLIC_COMACARD_API_URL="https://api-production-1141.up.railway.app"
# Envio GraphQL endpoint the app reads proof history from. Same URL as INDEXER_URL
# above; a separate NEXT_PUBLIC_ name because Next only inlines that prefix.
NEXT_PUBLIC_INDEXER_URL="https://indexer.dev.hyperindex.xyz/5d01570/v1/graphql"
# Alamat kontrak yang dibaca dan ditulis app. Tanpa fallback: alamat salah yang gagal
# keras lebih baik daripada alamat basi yang diam-diam jalan ke deployment lama.
NEXT_PUBLIC_SOURCE_VAULT="0x911290c37E9558C704870f4C44CBdEA1B2B33303"
